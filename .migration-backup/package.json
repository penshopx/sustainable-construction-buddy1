{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node api-server.cjs\" \"vite\"",
    "dev:vite": "vite",
    "dev:api": "node api-server.cjs",
    "configure:auth-redirects": "node scripts/configure-auth-redirects.cjs",
    "agent:content": "node scripts/content-agent.cjs",
    "agent:content:watch": "node scripts/content-agent-watch.cjs",
    "build": "npm run typecheck && vite build",
    "build:dev": "npm run typecheck && vite build --mode development",
    "release": "npm run test:insight:validate && npm run build && npm run publish:insight",
    "start": "node server.cjs",
    "test:routing": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium && PLAYWRIGHT_BROWSERS_PATH=0 playwright test tests/routing-smoke.spec.js",
    "test:auth": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium && PLAYWRIGHT_BROWSERS_PATH=0 playwright test --grep @pr-auth",
    "test:smoke": "npm run test:rate-limit && node scripts/smoke-test.cjs",
    "test:insight": "node --test tests/competency-insight-contract.test.mjs",
    "test:insight:publish": "node --test tests/publish-competency-insight.test.mjs tests/verify-competency-insight.test.mjs tests/subprocess-diagnostics.test.mjs",
    "test:insight:validate": "node scripts/validate-competency-insight.mjs",
    "test:insight:live": "node scripts/verify-competency-insight.mjs",
    "validate:insight": "npm run test:insight:validate",
    "publish:insight": "node scripts/publish-competency-insight.mjs",
    "check:release-config": "node scripts/publish-competency-insight.mjs --check-config",
    "test:rate-limit": "node --test tests/public-chat-rate-limit.test.cjs",
    "test:assessment:concurrency": "bash scripts/test-submit-assessment-concurrency.sh",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@iarna/toml": "^2.2.5",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-aspect-ratio": "^1.1.10",
