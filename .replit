modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pub-aspekindo-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "workspace-typecheck"

[[workflows.workflow]]
name = "pub-aspekindo-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/pub-aspekindo run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "workspace-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
VITE_SUPABASE_URL = "https://yidlglstzvizsszrpobi.supabase.co"

[userenv.production]
SUPABASE_PROJECT_REF = "yidlglstzvizsszrpobi"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 4200

[[ports]]
localPort = 3003
externalPort = 3003

[[ports]]
localPort = 3100
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80
exposeLocalhost = true

[[ports]]
localPort = 5002
externalPort = 5000

[[ports]]
localPort = 5100
externalPort = 6000

[[ports]]
localPort = 5173
externalPort = 5173

[nix]
channel = "stable-25_05"
packages = ["alsa-lib", "at-spi2-atk", "at-spi2-core", "atk", "dbus", "glib", "libgbm", "libxkbcommon", "mesa", "nspr", "nss", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "tesseract"]
